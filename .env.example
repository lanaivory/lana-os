# From https://console.twilio.com/ — never commit real values
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# Cloud sync (Vercel KV / Upstash Redis REST) + passcode gate
# Create a KV store in the Vercel dashboard (Storage → Create → KV),
# then copy these connection vars (or run `vercel env pull`).
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_URL=
APP_PASSCODE=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Subject must be a mailto: (or https:) contact URI.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
